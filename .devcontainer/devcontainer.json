{
  "name": "Baobab IAM Development",
  "image": "ghcr.io/nabhold/baobab-dev:1.3.0",
  "postCreateCommand": "make dev-up && sleep 10 && make bootstrap",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ]
    }
  },
  "forwardPorts": [8080, 9000, 5432],
  "remoteUser": "vscode"
}
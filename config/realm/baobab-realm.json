{
  "realm": "baobab",
  "enabled": true,
  "organizationsEnabled": true,
  "displayName": "Baobab Platform",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "defaultRoles": ["offline_access", "uma_authorization"],
  "roles": {
    "realm": [
      {
        "name": "iam:security-admin",
        "description": "Gate IAM-5 (ADR-0009 §15,§61,§102-103): IAM/Keycloak security administration. Distinct from iam:helpdesk; grants no privilege in other domains (§14).",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "iam:helpdesk",
        "description": "Gate IAM-5 (ADR-0009 §61-62,§102): user lookup and approved recovery assistance. Does not imply iam:security-admin (§61).",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "cp:platform-admin",
        "description": "Gate IAM-5 (ADR-0009 §16,§103): baobab-cp platform administration (tenants, capabilities, canonical mappings). No authority in IAM/ERP/Trade/CMS (§14).",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "cp:tenant-admin",
        "description": "Gate IAM-5 (ADR-0009 §102): tenant-scoped baobab-cp administration, narrower than cp:platform-admin.",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "trade:operator",
        "description": "Gate IAM-5 (ADR-0009 §17,§103): baobab-trade commerce administration per Trade's own policy. No authority in CP/ERP/CMS/IAM (§14,§17).",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "cms:editor",
        "description": "Gate IAM-5 (ADR-0009 §20): CMS content create/edit/submit-for-review. Does not include cms:publisher (§20-21).",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "cms:publisher",
        "description": "Gate IAM-5 (ADR-0009 §21,§103): CMS publish authority, separable from cms:editor. No authority in CP/ERP/Trade/IAM (§14).",
        "composite": true,
        "composites": { "realm": ["iam:mfa-required"] }
      },
      {
        "name": "iam:mfa-required",
        "description": "Gate IAM-11 (ADR-0015 §24): marker role, not assigned directly. Every workforce admin role composites it in for the browser flow's MFA condition."
      }
    ]
  },
  "requiredCredentials": ["password"],
  "passwordPolicy": "length(15) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyRpEntityName": "Baobab",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyRpId": "localhost",
  "webAuthnPolicyAttestationConveyancePreference": "not specified",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyAcceptableAaguids": [],
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "smtpServer": {},
  "loginTheme": "baobab",
  "accountTheme": "baobab",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "VALIDATE_ACCESS_TOKEN",
    "VALIDATE_ACCESS_TOKEN_ERROR",
    "INTROSPECT_TOKEN",
    "INTROSPECT_TOKEN_ERROR",
    "FEDERATED_IDENTITY_LINK",
    "FEDERATED_IDENTITY_LINK_ERROR",
    "REMOVE_FEDERATED_IDENTITY",
    "REMOVE_FEDERATED_IDENTITY_ERROR",
    "UPDATE_EMAIL",
    "UPDATE_EMAIL_ERROR",
    "UPDATE_PROFILE",
    "UPDATE_PROFILE_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "UPDATE_TOTP",
    "UPDATE_TOTP_ERROR",
    "VERIFY_EMAIL",
    "VERIFY_EMAIL_ERROR",
    "REMOVE_TOTP",
    "REMOVE_TOTP_ERROR",
    "GRANT_CONSENT",
    "GRANT_CONSENT_ERROR",
    "UPDATE_CONSENT",
    "UPDATE_CONSENT_ERROR",
    "REVOKE_GRANT",
    "REVOKE_GRANT_ERROR",
    "SEND_VERIFY_EMAIL",
    "SEND_VERIFY_EMAIL_ERROR",
    "SEND_RESET_PASSWORD",
    "SEND_RESET_PASSWORD_ERROR",
    "SEND_IDENTITY_PROVIDER_LINK",
    "SEND_IDENTITY_PROVIDER_LINK_ERROR",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "RESTART_AUTHENTICATION",
    "RESTART_AUTHENTICATION_ERROR",
    "INVALID_SIGNATURE",
    "INVALID_SIGNATURE_ERROR",
    "REGISTER_NODE",
    "REGISTER_NODE_ERROR",
    "UNREGISTER_NODE",
    "UNREGISTER_NODE_ERROR",
    "USER_INFO_REQUEST",
    "USER_INFO_REQUEST_ERROR",
    "USER_INFO_RESPONSE",
    "USER_INFO_RESPONSE_ERROR"
  ],
  "browserFlow": "Baobab browser",
  "authenticationFlows": [
    {
      "alias": "Baobab browser",
      "description": "Gate IAM-11 (ADR-0015 §24): copy of Keycloak's built-in 'browser' flow, plus a conditional MFA subflow gated on the iam:mfa-required role.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "Baobab forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "Baobab forms",
      "description": "Gate IAM-11: username/password, then the privileged-MFA condition.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "Baobab - Privileged MFA",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "Baobab - Privileged MFA",
      "description": "Gate IAM-11 (ADR-0015 §24): requires OTP only for users holding iam:mfa-required (directly or via composite role).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "baobab-mfa-required-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "baobab-mfa-required-role",
      "config": {
        "condUserRole": "iam:mfa-required"
      }
    }
  ],
  "attributes": {
    "frontendUrl": "",
    "clientSessionIdleTimeout": "1800",
    "clientSessionMaxLifespan": "36000",
    "clientOfflineSessionIdleTimeout": "2592000",
    "clientOfflineSessionMaxLifespan": "5184000",
    "accessTokenLifespan": "900",
    "accessTokenLifespanForImplicitFlow": "900",
    "ssoSessionIdleTimeout": "1800",
    "ssoSessionMaxLifespan": "36000",
    "ssoSessionIdleTimeoutRememberMe": "2592000",
    "ssoSessionMaxLifespanRememberMe": "2592000",
    "offlineSessionIdleTimeout": "2592000",
    "offlineSessionMaxLifespanEnabled": "false",
    "offlineSessionMaxLifespan": "5184000",
    "clientSessionIdleTimeoutRememberMe": "0",
    "clientSessionMaxLifespanRememberMe": "0",
    "loginWithPhoneAllowed": "false",
    "deleteCredentialsIfRealmIsRemoved": "true"
  }
}
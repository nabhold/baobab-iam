{
  "clientId": "baobab-erp-workload",
  "name": "Baobab ERP Workload",
  "description": "Workload identity for the ERP engine. Gate IAM-10 (ADR-0014 §111): carries erp:integrate alongside context:resolve so iDempiere's own OSGi bundles can authenticate to baobab-app's integration boundary, not only baobab-cp.",
  "enabled": true,
  "publicClient": false,
  "bearerOnly": false,
  "serviceAccountsEnabled": true,
  "protocol": "openid-connect",
  "directAccessGrantsEnabled": false,
  "implicitFlowEnabled": false,
  "standardFlowEnabled": false,
  "attributes": {
    "oauth2.device.authorization.grant.enabled": "false",
    "backchannel.logout.session.required": "false",
    "backchannel.logout.revoke.offline.tokens": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "profile",
    "email",
    "roles",
    "openid",
    "actor-type-workload",
    "context:resolve",
    "erp:integrate"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ]
}

# .env.example – copy to .env for local development
# Never commit production secrets.

# Keycloak admin credentials (used by bootstrap script)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Database
POSTGRES_USER=baobab_iam
POSTGRES_PASSWORD=changeme
POSTGRES_DB=baobab_iam

# Keycloak database connection
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/baobab_iam
KC_DB_USERNAME=baobab_iam
KC_DB_PASSWORD=changeme

# Keycloak hostname (for local)
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_HOSTNAME_STRICT=false

# Logging
KC_LOG_LEVEL=INFO